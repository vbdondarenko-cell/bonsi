# Публічна адреса сайту (для metadataBase, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: ключ service_role використовується ЛИШЕ на сервері (route handler).
# Ніколи не додавайте його з префіксом NEXT_PUBLIC_ і не комітьте реальні значення.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Довга випадкова сіль для хешування IP (антиспам). Згенерувати: openssl rand -hex 32
ORDER_HASH_SALT=

# Як сервер визначає IP клієнта для ліміту заявок. Значення: none | vercel | cloudflare | hops:N.
# Без довіреного проксі підроблені X-Forwarded-For ігноруються. На Vercel за замовчуванням "vercel", інакше "none".
TRUSTED_PROXY=

# Список ref-ів Supabase-проєктів, до яких підключатися ЗАБОРОНЕНО (через кому). check:env відмовить.
SUPABASE_FORBIDDEN_PROJECT_REFS=

# Дані оператора для сторінки /privacy (публічні)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Адмінпанель /admin (V0.2) ---
# Публічний anon/publishable ключ ТОГО Ж проєкту Supabase (для Auth-сесій адміністраторів; доступ до даних обмежує RLS).
SUPABASE_ANON_KEY=

# --- Telegram-сповіщення про нові заявки (необов'язково; без токена інтеграція вимкнена) ---
# Токен бота від @BotFather і ID чатів адміністраторів через кому. Лише серверні змінні.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Секрет для /api/internal/notifications (повторні спроби доставки). Згенерувати: openssl rand -hex 32
CRON_SECRET=
